# ── Database ─────────────────────────────────────
CONTROL_PLANE_DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_control
DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_dev
TENANT_DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_dev

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://:revualy_dev@localhost:6379

# ── Server ───────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3001

# ── Auth ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
INTERNAL_API_SECRET=your-internal-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Local testing (DEV ONLY — never enable in production) ─
# Enables the key-gated test-login endpoint (web: /api/test-login) and the
# chat-simulation harness (api: /api/v1/dev/simulate-chat). Both require BOTH
# the flag below AND the matching key, so a stray flag is not an open door.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEST_LOGIN_ENABLED=false
TEST_LOGIN_KEY=

# ── Proxy ───────────────────────────────────────
# Number of trusted proxy hops in front of the API (1 on Railway). Leave
# unset locally, otherwise X-Forwarded-For can be spoofed to dodge rate limits.
TRUST_PROXY=

# ── Internal API (Next.js → Fastify) ────────────
INTERNAL_API_URL=http://localhost:3000
# Org ID used for auth lookups (single-org beta; multi-org will use email domain routing)
DEFAULT_ORG_ID=dev-org

# ── Scheduler ───────────────────────────────────
# Chat platform used when the interaction scheduler initiates conversations.
# One of: slack | google_chat | teams | internal
SCHEDULER_PLATFORM=slack

# ── Encryption (64-char hex = 32 bytes AES-256) ─
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Slack ────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-token

# ── Google Chat ──────────────────────────────────
GCHAT_SERVICE_ACCOUNT_KEY=
GCHAT_PROJECT_ID=
GCHAT_VERIFICATION_TOKEN=

# ── Google Calendar ──────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# ── AI / LLM ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_MODEL_ADVANCED=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email (Resend) ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@revualy.com

# ── WebSocket ──────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_TOKEN_SECRET=
