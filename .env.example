# ── Database ─────────────────────────────────────
CONTROL_PLANE_DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_control
DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_dev
TENANT_DATABASE_URL=postgresql://revualy:revualy@localhost:5432/revualy_dev

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://:revualy_dev@localhost:6379

# ── Server ───────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3001

# ── Auth ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-here
AUTH_SECRET=your-secret-here
INTERNAL_API_SECRET=your-internal-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Local testing (DEV ONLY — never enable in production) ─
# Enables the key-gated test-login endpoint (web: /api/test-login) and the
# chat-simulation harness (api: /api/v1/dev/simulate-chat). Both require BOTH
# the flag below AND the matching key, so a stray flag is not an open door.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TEST_LOGIN_ENABLED=false
TEST_LOGIN_KEY=

# ── Proxy ───────────────────────────────────────
# Number of trusted proxy hops in front of the API (1 on Railway). Leave
# unset locally, otherwise X-Forwarded-For can be spoofed to dodge rate limits.
TRUST_PROXY=

# ── Internal API (Next.js → Fastify) ────────────
INTERNAL_API_URL=http://localhost:3000
# Org ID used for auth lookups (single-org beta; multi-org will use email domain routing)
DEFAULT_ORG_ID=dev-org

# ── Scheduler ───────────────────────────────────
# Chat platform used when the interaction scheduler initiates conversations.
# One of: slack | google_chat | teams | internal
SCHEDULER_PLATFORM=slack

# ── Encryption at rest (AES-256-GCM) ────────────
# REQUIRED in every environment for BOTH the API and the web service: feedback
# content is encrypted at rest and both read it. Without a key they refuse to
# start. Back the key up outside Railway: losing it means losing the data.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Rotation: list keys newest first as id:hex. New writes use the first key,
# older ids keep decrypting. Takes precedence over ENCRYPTION_KEY; the old
# single key has id "k1", e.g. ENCRYPTION_KEYS=k2:<new hex>,k1:<old hex>
# ENCRYPTION_KEYS=
# Legacy (pre-encryption) values stay readable until this is "off". Turn it
# off once `pnpm --filter @revualy/db encryption check` passes (docs/key-rotation.md).
# ENCRYPTION_LEGACY_READS=on   # only until a pre-encryption database is backfilled; default off

# Tier A reviewer pseudonyms: HMAC secret, 32+ characters, per tenant, never
# rotated casually (changing it breaks duplicate checks and re-identification).
# The API refuses to start without it. Generate: openssl rand -hex 32
REVIEWER_PSEUDONYM_SECRET=

# ── Slack ────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-token

# ── Google Chat ──────────────────────────────────
GCHAT_SERVICE_ACCOUNT_KEY=
GCHAT_PROJECT_ID=
# Must match the Chat API "Authentication audience" setting: the Google Cloud
# project NUMBER (digits) or the https webhook URL. Required: every event's
# signed Google token is verified against it.
GOOGLE_CHAT_AUDIENCE=
# Deprecated shared token. Ignored unless GCHAT_ALLOW_LEGACY_TOKEN=true.
GCHAT_VERIFICATION_TOKEN=
GCHAT_ALLOW_LEGACY_TOKEN=false

# ── Google Calendar ──────────────────────────────
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# ── AI / LLM ────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_BASE_URL=
# Models default to the newest per tier (fast: claude-haiku-4-5, standard:
# claude-sonnet-5, advanced: claude-opus-5-5; see packages/ai-core/src/gateway.ts).
# Set these to pin a tier once a stable base is chosen.
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_MODEL_ADVANCED=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email (Resend) ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@revualy.com

# ── WebSocket ──────────────────────────────────
NEXT_PUBLIC_WS_URL=ws://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_TOKEN_SECRET=
