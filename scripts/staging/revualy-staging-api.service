[Unit]
Description=Revualy staging API (localhost:3000)
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/revualy-staging/current
EnvironmentFile=%h/revualy-staging/staging.env
# Optional: the Anthropic key for the bot and 1:1 extraction. Not copied here;
# missing file = LLM calls fail, everything else works.
EnvironmentFile=-%h/.config/revualy-eval/anthropic.env
Environment=HOST=127.0.0.1 PORT=3000 NODE_ENV=production
ExecStart=/usr/bin/env node apps/api/dist/server.js
Restart=on-failure
RestartSec=5
# Keep it light: the box also runs eval work.
CPUQuota=200%
MemoryMax=2G

[Install]
WantedBy=default.target
