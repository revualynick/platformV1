[Unit]
Description=Revualy staging web (localhost:3001)
After=network-online.target revualy-staging-api.service

[Service]
Type=simple
WorkingDirectory=%h/revualy-staging/current/apps/web/.next/standalone
EnvironmentFile=%h/revualy-staging/staging.env
Environment=HOSTNAME=127.0.0.1 PORT=3001 NODE_ENV=production
ExecStart=/usr/bin/env node apps/web/server.js
Restart=on-failure
RestartSec=5
CPUQuota=200%
MemoryMax=2G

[Install]
WantedBy=default.target
